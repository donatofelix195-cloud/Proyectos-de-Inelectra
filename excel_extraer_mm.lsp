(defun EX_AnexoReductores (xs cr counts / col_idx d_val rt tc)
  (setq col_idx 6 cr (1+ cr))
  (setq rt (vlax-get-property xs 'Range (strcat "E" (itoa cr) ":E" (itoa (+ cr 1)))))
  (vlax-put-property (vlax-get-property rt 'Interior) 'Color 13421823) (vlax-put-property (vlax-get-property rt 'Font) 'Bold :vlax-true)
  (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa cr))) 'Value2 "DIAMETRO")
  (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa (+ cr 1)))) 'Value2 "CANTIDAD")
  (foreach item counts
    (setq d_val (car item))
    (vlax-put-property (vlax-get-property xs 'Range (strcat (EX_GEX col_idx) (itoa cr))) 'Value2 d_val)
    (vlax-put-property (vlax-get-property xs 'Range (strcat (EX_GEX col_idx) (itoa (+ cr 1)))) 'Value2 (cdr item))
    (setq col_idx (1+ col_idx))
  )
  (setq tc (vlax-get-property xs 'Range (strcat "E" (itoa (1- cr)) ":" (EX_GEX (1- col_idx)) (itoa (1- cr)))))
  (vlax-put-property tc 'MergeCells :vlax-true) (vl-catch-all-apply 'vlax-put-property (list tc 'HorizontalAlignment -4108)) (vlax-put-property tc 'Value2 "--- ANEXO: REDUCCIONES ---") (vlax-put-property (vlax-get-property tc 'Font) 'Bold :vlax-true) (vlax-put-property (vlax-get-property tc 'Interior) 'Color 13421823)
  cr
)

(defun EX_AnexoTipos (xs cr counts forma mat / col_idx d_val total t_lr t_ll t_lb dec_dia rt tc tipo_pair)
  (setq col_idx 6 cr (1+ cr)) ;; Column E for labels, F+ for data
  (setq rt (vlax-get-property xs 'Range (strcat "E" (itoa cr) ":E" (itoa (+ cr 2)))))
  (vlax-put-property (vlax-get-property rt 'Interior) 'Color 13421823) (vlax-put-property (vlax-get-property rt 'Font) 'Bold :vlax-true)
  (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa cr))) 'Value2 "TIPO")
  (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa (+ cr 1)))) 'Value2 "CANTIDAD")
  (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa (+ cr 2)))) 'Value2 "CODIGO TIPO")
  (foreach item counts
    (setq d_val (car item) total (cdr item))
    (setq t_lr (fix (+ (* total 0.3) 0.5)) t_ll (fix (+ (* total 0.3) 0.5)) t_lb (- total t_lr t_ll))
    (setq dec_dia (EX_DiametroDecimal d_val))
    (foreach tipo_pair (list (cons "LR" t_lr) (cons "LL" t_ll) (cons "LB" t_lb))
      (if (> (cdr tipo_pair) 0)
        (progn
          (vlax-put-property (vlax-get-property xs 'Range (strcat (EX_GEX col_idx) (itoa cr))) 'Value2 (strcat (car tipo_pair) " (" d_val ")"))
          (vlax-put-property (vlax-get-property xs 'Range (strcat (EX_GEX col_idx) (itoa (+ cr 1)))) 'Value2 (cdr tipo_pair))
