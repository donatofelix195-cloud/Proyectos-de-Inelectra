;;; v9.8.2: Migración completa de lógica IN a MM. LB al 40%. Búsqueda dinámica Book3.csv.

(vl-load-com)

;; --- FUNCIONES AUXILIARES ---
(defun EX_GEX (n / a r) (setq a "") (while (> n 0) (setq r (rem (1- n) 26) a (strcat (chr (+ 65 r)) a) n (/ (1- n) 26))) a)
(defun EX_Clean (s) (if s (vl-string-trim " \t\r\n" s) ""))
(defun EX_Atof (s) (if s (atof (vl-string-translate "," "." (EX_Clean s))) 0.0))
(defun EX_FormatearFraccion (s) (cond ((= s "0.5") "1/2\"") ((= s "0.75") "3/4\"") ((= s "1") "1\"") ((= s "1.25") "1 1/4\"") ((= s "1.5") "1 1/2\"") ((= s "2") "2\"") ((= s "2.5") "2 1/2\"") ((= s "3") "3\"") ((= s "4") "4\"") (t (strcat s "\""))))

(defun EX_GBO (bn / d b r)
  (setq d (vla-get-Blocks (vla-get-ActiveDocument (vlax-get-acad-object))) r '())
  (if (not (vl-catch-all-error-p (setq b (vl-catch-all-apply 'vla-item (list d bn))))) 
    (vlax-for e b (if (= (vla-get-ObjectName e) "AcDbAttributeDefinition") (setq r (cons (vla-get-TagString e) r)))))
  (reverse r)
)

(defun EX_GCA (bn / d b r)
  (setq d (vla-get-Blocks (vla-get-ActiveDocument (vlax-get-acad-object))) r '())
  (if (not (vl-catch-all-error-p (setq b (vl-catch-all-apply 'vla-item (list d bn))))) 
    (vlax-for e b (if (and (= (vla-get-ObjectName e) "AcDbAttributeDefinition") (= (vla-get-Constant e) :vlax-true)) 
      (setq r (cons (cons (vla-get-TagString e) (vla-get-TextString e)) r)))))
  r
)

(defun EX_PIB (tg vl / n q r m pos)
  (setq q (chr 34) r nil n (distof vl))
  ;; --- MOTOR DE FILTRADO v9.8.2 ---
  (if (or (member (strcase tg) '("TAG" "TRAMO" "ID" "IDENT" "IDENTIFICADOR" "ID_TRAMO" "ID_TAG" "T_CONDUIT" "HANDLE"))
          (wcmatch (strcase tg) "*TRAMO*") (wcmatch (strcase tg) "*TAG*") (wcmatch (strcase tg) "*ID*"))
    (progn
      (if (setq pos (vl-string-search "(" vl)) (setq vl (vl-string-right-trim " " (substr vl 1 pos))))
      (if (setq pos (vl-string-search " " vl)) (setq vl (substr vl 1 pos)))
      (setq r (list "TXT" vl))
    )
  )
  
  (if (and (not r) n (/= vl ""))
    (cond 
      ((member (strcase tg) '("LONGITUD" "L" "LEN" "LENGTH" "LONG"))
       (setq m n) (if (< m 1000) (setq m 1000.0) (setq m (* (fix (+ (/ m 1000.0) 0.5)) 1000.0)))
       (setq r (list "WMM" (strcat (rtos (/ m 1000.0) 2 2) " m") m)))
      ((or (wcmatch (strcase tg) "*DIAM*") (wcmatch (strcase tg) "*REDUC*") (member (strcase tg) '("D" "DIA" "DIAMETRO")))
       (setq r (list "TXT" 
         (cond 
           ((equal n 0.75 0.01) "3/4\"")
           ((equal n 1.0 0.01)  "1\"")
           ((equal n 1.5 0.01)  "1 1/2\"")
           ((equal n 2.0 0.01)  "2\"")
           (t (strcat (rtos n 2 2) q))
         ))))
      ((member (strcase tg) '("PZ" "PZS" "CANT" "QTY" "CANTIDAD")) (setq r (list "NUM" (fix (+ n 0.999999)))))
      (t (setq r (list "NUM" n)))
    )
    (if (or (wcmatch (strcase tg) "*DIAM*") (wcmatch vl (strcat "*" q "*"))) (setq r (list "TXT" (strcat "'" vl))) (setq r (list "RAW" vl)))
  ) r
)

;; --- TRADUCTOR DE DIAMETROS ---
(defun EX_DiametroDecimal (dia)
  (cond
    ((= dia "1/2\"") "0.5")
    ((= dia "3/4\"") "0.75")
    ((= dia "1\"") "1")
    ((= dia "1 1/4\"") "1.25")
    ((= dia "1 1/2\"") "1.5")
    ((= dia "2\"") "2")
    ((= dia "2 1/2\"") "2.5")
    ((= dia "3\"") "3")
    ((= dia "4\"") "4")
    (t dia)
  )
)

;; --- LECTOR CSV ROBUSTO ---
(defun EX_ParseCSVLine (str / len i c inQuotes fld result nextC)
  (setq len (strlen str) i 1 inQuotes nil fld "" result '())
  (while (<= i len)
    (setq c (substr str i 1))
    (if (= c "\"")
      (progn
        (if (< i len) (setq nextC (substr str (1+ i) 1)) (setq nextC ""))
        (if (= nextC "\"")
          (progn (setq fld (strcat fld "\"") i (1+ i)))
          (setq inQuotes (not inQuotes))
        )
      )
      (if (and (= c ",") (not inQuotes))
        (progn (setq result (append result (list fld)) fld ""))
        (setq fld (strcat fld c))
      )
    )
    (setq i (1+ i))
  )
  (setq result (append result (list fld)))
  result
)

(defun EX_QuotesBalanced (str / i len inQuotes c)
  (setq i 1 len (strlen str) inQuotes nil)
  (while (<= i len)
    (setq c (substr str i 1))
    (if (= c "\"") (setq inQuotes (not inQuotes)))
    (setq i (1+ i))
  )
  (not inQuotes)
)

(defun EX_ReadFullCSVLine (fp / line next_line)
  (setq line (read-line fp))
  (if line
    (while (and (not (EX_QuotesBalanced line)) (setq next_line (read-line fp)))
      (setq line (strcat line " " next_line))
    )
  )
  line
)

;; --- OBTENER RUTA DINAMICA DE Book3.csv ---
(defun EX_GetCSVPath (/ p)
  (if (and *EX_CSV_PATH* (findfile *EX_CSV_PATH*))
    *EX_CSV_PATH*
    (progn
      (setq p (cond
        ((findfile (strcat (getvar "DWGPREFIX") "Book3.csv")))
        ((findfile "Book3.csv"))
        ((and (setq p (findfile "excel_extraer_mm.lsp"))
              (setq p (strcat (vl-filename-directory p) "\\Book3.csv"))
              (findfile p)) p)
        (t nil)
      ))
      (if (not p) (setq p (getfiled "No se encontro Book3.csv automáticamente. Por favor, selecciónelo:" "Book3.csv" "csv" 16)))
      (setq *EX_CSV_PATH* p)
    )
  )
)

;; --- FUNCIONES DE BUSQUEDA EN CSV ---
(defun EX_BuscarDentCode (diametro forma material unidad tipo / csv_path fp line fields col_a col_b fq ft pat_mat pat_forma pat_tipo result fallback_result fallback_desc found d_num)
  (setq csv_path (EX_GetCSVPath))
  (setq d_num (EX_Atof diametro) result nil fallback_result nil fallback_desc nil found nil)
  (setq fp (open csv_path "r"))
  (if fp
    (progn
      (setq pat_mat (strcase (if (wcmatch (strcase material) "*GALV*") "*GALV*" (strcat "*" material "*"))))
      (setq pat_forma (strcase (strcat "*FORMA*" forma "*")))
      (setq pat_tipo (if (and tipo (/= tipo "")) (strcase (strcat "*TIPO " (chr 34) tipo (chr 34) "*")) nil))
      (read-line fp)
      (while (and (not found) (setq line (EX_ReadFullCSVLine fp)))
        (setq fields (EX_ParseCSVLine line))
        (if (>= (length fields) 17)
          (progn
            (setq col_a (EX_Clean (nth 0 fields)) col_b (strcase (nth 1 fields)) fq (nth 16 fields))
            (if (and (or (not unidad) (<= (length fields) 19) (wcmatch (strcase (nth 19 fields)) "*IN*"))
                     (or (= (EX_Atof fq) d_num) (< (abs (- (EX_Atof fq) d_num)) 0.05))
                     (wcmatch col_b "*CONDULETA*")
                     (wcmatch col_b pat_mat)
                     (or (not pat_tipo) (wcmatch col_b pat_tipo)))
              (if (wcmatch col_b pat_forma)
                (progn (setq result col_a *ultima_desc* col_b found T))
                (if (not fallback_result) (setq fallback_result col_a fallback_desc col_b))
              )
            )
          )
        )
      )
      (close fp)
      (if (not result) (progn (setq result fallback_result) (if fallback_desc (setq *ultima_desc* fallback_desc))))
    )
  )
  result
)

