(defun EX_BuscarReductorCode (dia1 dia2 / csv_path fp line fields col_a col_b fq ft result found d_num1 d_num2)
  (setq csv_path (EX_GetCSVPath))
  (setq d_num1 (atof dia1) d_num2 (atof dia2) result nil found nil)
  (setq fp (open csv_path "r"))
  (if fp
    (progn
      (read-line fp)
      (while (and (not found) (setq line (EX_ReadFullCSVLine fp)))
        (setq fields (EX_ParseCSVLine line))
        (if (>= (length fields) 18)
          (progn
            (setq col_a (nth 0 fields) col_b (nth 1 fields) fq (nth 16 fields) ft (nth 17 fields))
            (if (and (or (<= (length fields) 19) (wcmatch (strcase (nth 19 fields)) "*IN*"))
                     (or (= (atof fq) d_num1) (< (abs (- (atof fq) d_num1)) 0.02))
                     (or (= (atof ft) d_num2) (< (abs (- (atof ft) d_num2)) 0.02))
                     (wcmatch (strcase col_b) "*ACOPLE*REDUCTOR*"))
              (progn (setq result col_a found T))
            )
          )
        )
      )
      (close fp)
    )
  )
  result
)

(defun EX_AnexoReductores (xs cr counts / col_idx d1 d2 d1_fmt d2_fmt rt tc codigo it header_range sorted_counts)
  (if (and counts (> (length counts) 0))
    (progn
      ;; Sort counts by dia1 desc, then dia2 desc
      (setq sorted_counts (vl-sort counts 
        (function (lambda (a b) 
          (if (/= (atof (caar a)) (atof (caar b)))
            (> (atof (caar a)) (atof (caar b)))
            (> (atof (cdar a)) (atof (cdar b)))
          )
        ))
      ))
      (setq col_idx 6 cr (1+ cr)) ;; Column E for labels
      (setq rt (vlax-get-property xs 'Range (strcat "E" (itoa cr) ":E" (itoa (+ cr 2)))))
      (vlax-put-property (vlax-get-property rt 'Interior) 'Color 13421823)
      (vlax-put-property (vlax-get-property rt 'Font) 'Bold :vlax-true)
      (vlax-put-property (vlax-get-property rt 'Font) 'Color 0)
      (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa cr))) 'Value2 "MEDIDA")
      (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa (+ cr 1)))) 'Value2 "CANTIDAD")
      (vlax-put-property (vlax-get-property xs 'Range (strcat "E" (itoa (+ cr 2)))) 'Value2 "CODIGO SPM")
      
      (foreach it sorted_counts
        (setq d1 (caar it) d2 (cdar it) cnt (cdr it))
        (setq d1_fmt (EX_FormatearFraccion d1) d2_fmt (EX_FormatearFraccion d2))
        (setq codigo (EX_BuscarReductorCode d1 d2))
        (setq tc (vlax-get-property xs 'Range (strcat (EX_GEX col_idx) (itoa cr))))
        (vlax-put-property tc 'Value2 (strcat d1_fmt " A " d2_fmt))
        (setq tc (vlax-get-property xs 'Range (strcat (EX_GEX col_idx) (itoa (+ cr 1)))))
        (vlax-put-property tc 'Value2 cnt)
        (setq tc (vlax-get-property xs 'Range (strcat (EX_GEX col_idx) (itoa (+ cr 2)))))
        (vlax-put-property tc 'Value2 (if codigo codigo "N/A"))
        (setq col_idx (1+ col_idx))
      )
      
      (setq header_range (vlax-get-property xs 'Range (strcat "E" (itoa (1- cr)) ":" (EX_GEX (1- col_idx)) (itoa (1- cr)))))
      (vlax-put-property header_range 'MergeCells :vlax-true)
      (vlax-put-property header_range 'Value2 "--- ANEXO: REDUCCIONES ---")
      (vlax-put-property (vlax-get-property header_range 'Font) 'Bold :vlax-true)
      (vlax-put-property (vlax-get-property header_range 'Interior) 'Color 13421823)
      (vl-catch-all-apply 'vlax-put-property (list header_range 'HorizontalAlignment -4108))
      (setq cr (+ cr 5))
    )
  )
  cr
)

;; --- COMANDO PRINCIPAL ---
(defun c:EXCEL_PRO ( / ss i e o n bl current df f id rs sb q c40 c41 xa xb xs r c t_s ty b_n b_o t_g v_l c_i er mi hm ft fc cr h tc ra pz ap range_str spm_col tipo_col dia_val dent_code *forma_idx* *mat_idx* desc_tee cond_counts tee_detailed_counts cond_assigned d_val it_c target_lr target_ll current_lr current_ll current_ll assigned_tipo pipe_sums tcm item_p start_cr start_cr_pipe reductor_counts)
